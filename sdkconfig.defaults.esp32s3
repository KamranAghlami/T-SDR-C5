# LilyGO T-Display-S3: ESP32-S3R8 (16 MB flash, 8 MB octal PSRAM). Applied on
# top of sdkconfig.defaults for the esp32s3 target.

# Static sections must end below the RF dump aperture at 0x3fcd0000 (IRAM
# alias 0x403c0000, components/s3_radio/sram_guard.ld). Bank 0 is not a
# constraint here, so the Wi-Fi .bss stays in internal RAM.
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
CONFIG_SPIRAM_MODE_OCT=y

# The radio loop runs on core 0 with the Wi-Fi/PHY tasks and the UI on core 1.
